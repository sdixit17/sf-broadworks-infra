[Unit]
Description=Telqon Voice AI (answers BroadWorks calls before the call center)
After=network-online.target
Wants=network-online.target

[Service]
User=voiceai
Group=voiceai
EnvironmentFile=/opt/telqon-voiceai/voiceai.env
WorkingDirectory=/opt/telqon-voiceai/current
ExecStart=/usr/bin/python3 -m voiceai
Restart=always
RestartSec=3
TimeoutStopSec=20
# SIP on port 5060 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/telqon-voiceai

[Install]
WantedBy=multi-user.target
